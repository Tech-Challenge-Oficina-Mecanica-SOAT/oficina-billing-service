# Copie para .env (que está no .gitignore). NUNCA commite credenciais.
# docker compose lê este arquivo para substituir as variáveis do docker-compose.yml.

# true  = Mercado Pago simulado (sem rede). false = sandbox real (precisa do token e de uma URL pública para o webhook).
MP_USE_FAKE=true

# Credencial de TESTE do Mercado Pago (painel de desenvolvedores > Suas integrações > Credenciais de teste)
MP_ACCESS_TOKEN=
# URL pública (ngrok/ALB) para onde o MP envia o webhook: https://<host>/pagamentos/webhook/mercado-pago
MP_NOTIFICATION_URL=
# Chave secreta do webhook (painel > Webhooks). Com MP_VALIDATE_SIGNATURE=true a assinatura x-signature é exigida.
MP_VALIDATE_SIGNATURE=false
MP_WEBHOOK_SECRET=

# Mensageria local: Log (só loga os eventos) ou Aws (LocalStack: docker compose --profile aws)
MESSAGING_PROVIDER=Log
MESSAGING_CONSUMER=false
AWS_SERVICE_URL=
