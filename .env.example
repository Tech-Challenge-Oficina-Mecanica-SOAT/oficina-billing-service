# Copie para ".env" (o Docker Compose lê esse arquivo sozinho; ele já está no .gitignore).
# Padrão = Mercado Pago FAKE (não precisa preencher nada). Para o SANDBOX de verdade:

MP_USE_FAKE=false

# Access Token de TESTE da sua aplicação (começa com TEST-). NUNCA coloque o de produção aqui.
MP_ACCESS_TOKEN=TEST-coloque-aqui

# URL PÚBLICA do webhook (ngrok http 5001). Termina com /pagamentos/webhook/mercado-pago
MP_NOTIFICATION_URL=https://SEU-SUBDOMINIO.ngrok-free.app/pagamentos/webhook/mercado-pago?source_news=webhooks

# Comece com false para isolar problemas; depois ligue (true) com o segredo do painel do MP.
MP_VALIDATE_SIGNATURE=false
MP_WEBHOOK_SECRET=cole-aqui-a-assinatura-secreta-do-painel
