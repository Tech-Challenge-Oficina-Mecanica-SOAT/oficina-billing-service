{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
  },
  "ConnectionStrings": { "BillingDb": "" },
  "Services": {
    "OsService": { "BaseUrl": "http://oficina-os-service.oficina.svc.cluster.local" },
    "CadastrosService": { "BaseUrl": "http://oficina-cadastros-service.oficina.svc.cluster.local" }
  },
  "Aws": { "Region": "us-east-1", "ServiceUrl": "" },
  "Messaging": { "Provider": "Aws", "Environment": "dev", "ConsumerEnabled": true, "QueueUrl": "" },
