        "jsonBody": { "id": "{{request.pathSegments.[1]}}", "descricao": "Peça de teste", "precoUnitario": 50.00 }
      }
    },
    {
      "name": "Cadastros - qualquer serviço",
      "request": { "method": "GET", "urlPathPattern": "/servicos/[0-9a-fA-F-]{36}" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "id": "{{request.pathSegments.[1]}}", "descricao": "Serviço de teste", "precoUnitario": 100.00 }
      }
    },
    {
      "name": "OS - consulta de ordem de serviço",
      "request": { "method": "GET", "urlPathPattern": "/ordens-servico/[0-9a-fA-F-]{36}" },
